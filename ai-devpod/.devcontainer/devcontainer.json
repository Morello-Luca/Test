{
  "name": "ai-coder",
  "postCreateCommand": "sed -i 's/\\r$//' /workspace/scripts/build-llama-cpp.sh /workspace/scripts/omni && bash /workspace/scripts/build-llama-cpp.sh && sudo install -m 755 /workspace/scripts/omni /usr/local/bin/omni",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    "--gpus=all"
  ],
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "remoteUser": "ubuntu",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ]
    }
  }
}
